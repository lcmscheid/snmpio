# --- Build directories ---
build/
build-*/
out/
# CLion
cmake-build-*/
# CMake FetchContent downloads
_deps/

# --- CMake generated ---
CMakeCache.txt
CMakeFiles/
# personal presets; CMakePresets.json IS tracked
CMakeUserPresets.json
cmake_install.cmake
CTestTestfile.cmake
Testing/
install_manifest.txt
*.cmake.in.tmp

# --- Compiled output ---
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb

# --- Tooling ---
# generated; regenerate rather than commit
compile_commands.json
# clangd index
.cache/
*.gcda
*.gcno
*.gcov
coverage/
*.profraw
*.profdata

# --- Fuzzing (Layer 1 BER decoder, per the staged plan) ---
# Corpora are deliberately NOT ignored: a curated seed corpus and any
# crash-reproducing input belong in the repo. Only transient output here.
fuzz/*/crash-*
fuzz/*/leak-*
fuzz/*/timeout-*
fuzz/**/fuzz-*.log
# libFuzzer's writable output dir; seeds live in fuzz/corpus. (A trailing comment on a
# pattern line is part of the pattern, not a comment, so this one has to sit above.)
.fuzz-work/
.fuzz-work-client/

# --- Secrets and local test material ---
# SNMPv3 passphrases must never be committed. Example configs with
# obviously-fake credentials are fine; anything named *.local. is not.
*.local.json
*.local.yaml
*.local.conf
*.pem
*.key
!examples/*.json

# --- Packet captures from interop debugging ---
# Often contain real device addresses and community strings.
*.pcap
*.pcapng

# --- Editor / OS ---
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*~
.DS_Store

# --- AI coding-agent harness ---
# Shared project instruction (CLAUDE.md / AGENTS.md) and shared settings are tracked
# deliberately: they are onboarding docs for agents, the same way CONTRIBUTING.md is for
# people. What must not be tracked is anything personal, machine-specific, or holding
# credentials.
.claude/settings.local.json
.claude/*.local.json
# session transcripts; may contain anything that was pasted in
.claude/projects/
.claude/shell-snapshots/
.claude/todos/
.claude/statsig/
# MCP server config with tokens; .mcp.json may be tracked if clean
.mcp.local.json
.aider*
.cursorignore
